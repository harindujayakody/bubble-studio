  "components": [
    {
      "name": "Brand Header",
      "kind": "nav",
      "refersTo": "header",
      "description": "56px gradient bar with white ghost controls and the white Export pill.",
      "html": "<header class=\"ds-header\"><span class=\"ds-header-mark\">Bubble Studio</span><button class=\"ds-header-btn\">New</button><span class=\"ds-header-spacer\"></span><button class=\"ds-header-btn\">Layers</button><button class=\"ds-cta\">Export</button></header>",
      "css": ".ds-header{display:flex;align-items:center;gap:10px;height:56px;padding:0 16px;background:linear-gradient(90deg,#5b1fc4 0%,#7d2ae8 42%,#0d9aa5 100%);color:#fff;font-family:Inter,ui-sans-serif,sans-serif}.ds-header-mark{font-family:Poppins,Inter,sans-serif;font-weight:700;font-size:15px}.ds-header-spacer{flex:1}.ds-header-btn{height:36px;padding:0 12px;border:0;border-radius:8px;background:transparent;color:#fff;font:500 14px Inter,sans-serif;cursor:pointer}.ds-header-btn:hover{background:rgb(255 255 255 / .16)}.ds-header-btn:focus-visible{outline:none;box-shadow:0 0 0 2px #fff}.ds-cta{height:36px;padding:0 14px;border:0;border-radius:8px;background:#fff;color:#4b19ad;font:600 14px Inter,sans-serif;box-shadow:0 1px 2px rgb(0 0 0 / .18);cursor:pointer}.ds-cta:hover{background:#f3edff}.ds-cta:focus-visible{outline:none;box-shadow:0 0 0 2px #fff}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Purple fill for the primary in-panel action.",
      "html": "<button class=\"ds-btn-primary\">Add a photo</button>",
      "css": ".ds-btn-primary{height:36px;padding:0 12px;border:0;border-radius:8px;background:var(--brand,#7d2ae8);color:#fff;font:500 14px Inter,sans-serif;cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:var(--brand-ink,#6420c7)}.ds-btn-primary:focus-visible{outline:2px solid var(--aqua,#00c4cc);outline-offset:2px}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Rail Tool",
      "kind": "nav",
      "refersTo": "rail-tool-active",
      "description": "Rail button: 40px icon tile and 11px label; the duo shape fills purple when active.",
      "html": "<div class=\"ds-rail\"><button class=\"ds-tool\" data-active><span class=\"ds-tool-tile\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle class=\"duo\" cx=\"9\" cy=\"9.5\" r=\"5.25\"/><circle cx=\"15\" cy=\"9.5\" r=\"5.25\"/><circle cx=\"12\" cy=\"14.75\" r=\"5.25\"/></svg></span><span>Filters</span></button><button class=\"ds-tool\"><span class=\"ds-tool-tile\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect class=\"duo\" x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3.5\"/><path d=\"m3.5 17 4.8-4.8a1.5 1.5 0 0 1 2.1 0L15 16.8\"/><path d=\"m13.5 15.3 1.7-1.7a1.5 1.5 0 0 1 2.1 0l3.4 3.4\"/><circle cx=\"15.5\" cy=\"8.75\" r=\"1.5\"/></svg></span><span>Photo</span></button></div>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:4px;width:76px;padding:10px 6px;background:var(--sheet,#fff);border-right:1px solid var(--rule,#e2e4ea)}.ds-tool{display:flex;flex-direction:column;align-items:center;gap:4px;padding:4px 0;border:0;border-radius:8px;background:none;color:var(--ink-soft,#5b6270);font:500 11px Inter,sans-serif;cursor:pointer}.ds-tool:hover{color:var(--ink,#0e1318)}.ds-tool-tile{display:grid;place-items:center;width:40px;height:40px;border-radius:11.2px;transition:background-color .15s}.ds-tool:hover .ds-tool-tile{background:var(--tile,#f2f3f6)}.ds-tool .duo{fill:transparent;transition:fill .15s ease-out}.ds-tool:hover .duo{fill:color-mix(in oklch,currentColor 10%,transparent)}.ds-tool[data-active]{color:var(--ink,#0e1318);font-weight:600}.ds-tool[data-active] .ds-tool-tile{background:var(--brand-wash,#f1e9fd);color:var(--brand,#7d2ae8)}.ds-tool[data-active] .duo{fill:color-mix(in oklch,var(--brand,#7d2ae8) 26%,transparent)}.ds-tool:focus-visible{outline:2px solid var(--aqua,#00c4cc)}"
    },
    {
      "name": "Size Chip",
      "kind": "chip",
      "refersTo": "size-chip",
      "description": "Round chip with a shape glyph, name and mono ratio.",
      "html": "<button class=\"ds-chip\"><span class=\"ds-chip-glyph\"></span>Square<span class=\"ds-chip-ratio\">1:1</span></button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px 0 10px;border:1px solid var(--rule,#e2e4ea);border-radius:9999px;background:var(--sheet,#fff);color:var(--ink,#0e1318);font:500 13px Inter,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-chip:hover{border-color:var(--brand,#7d2ae8);background:var(--brand-wash,#f1e9fd)}.ds-chip:focus-visible{outline:none;box-shadow:0 0 0 2px var(--aqua,#00c4cc)}.ds-chip-glyph{width:14px;height:14px;border:1.5px solid var(--brand,#7d2ae8);border-radius:3px}.ds-chip-ratio{font:11px 'Geist Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;color:var(--ink-soft,#5b6270)}"
    },
    {
      "name": "Create Card",
      "kind": "card",
      "refersTo": "create-card",
      "description": "Start-screen card: art well, title and body; floats on the workspace.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-row\"><span class=\"ds-card-well\"><span class=\"ds-card-art\"></span></span><span><span class=\"ds-card-title\">Photo post</span><span class=\"ds-card-body\">Filters, text, stickers and blur on a photo.</span></span></div></article>",
      "css": ".ds-card{max-width:440px;padding:20px;border-radius:14.4px;background:var(--sheet,#fff);box-shadow:0 1px 2px rgb(14 19 24 / .06),0 8px 24px -8px rgb(14 19 24 / .22)}.ds-card-row{display:flex;align-items:center;gap:16px}.ds-card-well{display:grid;place-items:center;flex:none;width:112px;height:112px;border-radius:11.2px;background:var(--tile,#f2f3f6);transition:background-color .2s}.ds-card:hover .ds-card-well{background:var(--brand-wash,#f1e9fd)}.ds-card-art{width:78%;height:78%;border-radius:8px;background:linear-gradient(135deg,#ff6b6b,#c026d3);transform:rotate(-3deg);transition:transform .3s ease-out;box-shadow:0 1px 2px rgb(14 19 24 / .08),0 16px 40px -16px rgb(14 19 24 / .28)}.ds-card:hover .ds-card-art{transform:none}.ds-card-title{display:block;font:600 18px Poppins,Inter,sans-serif;color:var(--ink,#0e1318)}.ds-card-body{display:block;margin-top:4px;font:14px/1.5 Inter,sans-serif;color:var(--ink-soft,#5b6270)}"
    },
    {
      "name": "Tool Tile",
      "kind": "card",
      "refersTo": "tool-tile",
      "description": "More tools tile with a lilac icon well; lifts 2px on hover.",
      "html": "<button class=\"ds-tile\"><span class=\"ds-tile-icon\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect class=\"duo\" x=\"2.5\" y=\"4\" width=\"8\" height=\"6.5\" rx=\"1.75\"/><rect x=\"2.5\" y=\"13.5\" width=\"8\" height=\"6.5\" rx=\"1.75\"/><path d=\"M10.5 7.25h2.25a2 2 0 0 1 2 2v5.5a2 2 0 0 1-2 2H10.5\"/><path d=\"M14.75 12h6.75M19 9.5 21.5 12 19 14.5\"/></svg></span><span><span class=\"ds-tile-title\">Merge videos</span><span class=\"ds-tile-body\">Join clips into one video</span></span></button>",
      "css": ".ds-tile{display:flex;align-items:center;gap:14px;width:280px;padding:12px;border:0;border-radius:11.2px;background:var(--sheet,#fff);text-align:left;cursor:pointer;box-shadow:0 1px 2px rgb(14 19 24 / .06),0 8px 24px -8px rgb(14 19 24 / .22);transition:transform .2s ease-out}.ds-tile:hover{transform:translateY(-2px)}.ds-tile .duo{fill:transparent;transition:fill .15s ease-out}.ds-tile:hover .duo{fill:color-mix(in oklch,currentColor 10%,transparent)}.ds-tile:focus-visible{outline:2px solid var(--aqua,#00c4cc)}.ds-tile-icon{display:grid;place-items:center;flex:none;width:48px;height:48px;border-radius:8px;background:var(--brand-wash,#f1e9fd);color:var(--brand,#7d2ae8)}.ds-tile-title{display:block;font:600 15px Poppins,Inter,sans-serif;color:var(--ink,#0e1318)}.ds-tile-body{display:block;font:13px/1.35 Inter,sans-serif;color:var(--ink-soft,#5b6270)}"
    },
    {
      "name": "Status Pill",
      "kind": "custom",
      "refersTo": "status-pill",
      "description": "Floating readout under the post: label, mono dimensions, zoom chip.",
      "html": "<div class=\"ds-status\"><span class=\"ds-status-label\">Square post</span><span class=\"ds-status-sep\"></span><span class=\"ds-mono\">1080 × 1080 px</span><span class=\"ds-status-zoom\">67%</span></div>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:12px;height:32px;padding:0 14px;border-radius:9999px;background:var(--raised,#fff);color:var(--ink-soft,#5b6270);font:12px Inter,sans-serif;box-shadow:0 1px 2px rgb(14 19 24 / .06),0 8px 24px -8px rgb(14 19 24 / .22)}.ds-status-label{color:var(--ink,#0e1318)}.ds-status-sep{width:1px;height:14px;background:var(--rule,#e2e4ea)}.ds-mono{font:11px 'Geist Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}.ds-status-zoom{padding:2px 8px;border-radius:9999px;background:var(--tile,#f2f3f6);color:var(--ink,#0e1318);font:11px 'Geist Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Colour Field",
      "kind": "input",
      "refersTo": "panel-section",
      "description": "Swatch row with a mono hex readout; the selected swatch takes a turquoise ring.",
      "html": "<div class=\"ds-color\"><div class=\"ds-color-head\"><label>Text colour</label><span class=\"ds-color-hex\">#7D2AE8</span></div><div class=\"ds-color-row\"><button class=\"ds-swatch\" style=\"background:#0e1318\"></button><button class=\"ds-swatch\" aria-pressed=\"true\" style=\"background:#7d2ae8\"></button><button class=\"ds-swatch\" style=\"background:#00c4cc\"></button><button class=\"ds-swatch\" style=\"background:#ffffff\"></button><span class=\"ds-swatch ds-swatch-custom\"></span></div></div>",
      "css": ".ds-color{display:grid;gap:8px;width:280px;font-family:Inter,sans-serif}.ds-color-head{display:flex;justify-content:space-between;align-items:baseline}.ds-color-head label{font-size:13px;color:var(--ink-soft,#5b6270)}.ds-color-hex{font:12px 'Geist Mono',ui-monospace,monospace;color:var(--ink-soft,#5b6270);text-transform:uppercase}.ds-color-row{display:flex;gap:6px}.ds-swatch{width:24px;height:24px;border:0;border-radius:3px;box-shadow:inset 0 0 0 1px rgb(14 19 24 / .15);cursor:pointer}.ds-swatch:hover{box-shadow:inset 0 0 0 1px rgb(14 19 24 / .35)}.ds-swatch:focus-visible{outline:2px solid var(--aqua,#00c4cc)}.ds-swatch[aria-pressed=true]{box-shadow:0 0 0 1px var(--sheet,#fff),0 0 0 3px var(--aqua,#00c4cc)}.ds-swatch-custom{background:conic-gradient(from 90deg,#00c4cc,#7d2ae8,#ffe600,#00c4cc)}"
    }
  ],
  "narrative": {
    "northStar": "The Calm Workspace",
    "overview": "Bubble Studio is a Canva-clean editor. The post floats on a quiet grey workspace (dark: a near-black one), plain sheet panels sit beside it with hairline rules and 8px corners, and the tools run down a left rail in the order you use them. All the brand energy lives in one purple-to-turquoise gradient: the 56px header across the top of every screen, continued into the hero band on the start screen. Everything else is calm, so the post is the most colourful thing on screen.\n\nColour carries meaning, not decoration. Purple is the brand and marks what you are doing: the active tool, the primary action, text layers. Turquoise marks what is selected on the canvas and where keyboard focus is. Yellow means crop. Neutrals do the rest. The system ships in light and dark, switched by a `dark` class on `<html>` that swaps CSS variables only; transitions pause for one frame during the switch so the whole app recolours at once. The post sheet, and anything drawn on it, stays light in both themes because it is the user's artwork, not chrome.\n\nThis world rejects the print-proof costume it replaced (crop marks, registration targets, CMYK strips, proof slugs) and the grey editor with a single lonely accent.",
    "keyCharacteristics": [
      "One brand gradient, in exactly two places: the header and the start hero band.",
      "Plain sheet panels with hairline rules, 8px base radius, soft ambient shadows only on floating things.",
      "Purple = active / primary / text; turquoise = selection / focus; yellow = crop.",
      "An authored duotone icon set whose \"duo\" shape fills purple on the active tool.",
      "Poppins headings, Inter UI, Geist Mono for numeric readouts.",
      "Light and dark by CSS variables alone; the post sheet stays light in both."
    ],
    "rules": [
      {
        "name": "The Two Places Rule",
        "body": "The brand gradient appears in the header and the start hero band, and nowhere else. No gradient buttons, panels, text or borders.",
        "section": "colors"
      },
      {
        "name": "The Meaning Rule",
        "body": "Purple says \"this is what you are doing\", turquoise says \"this is what is selected or focused\", yellow says \"crop\". Never swap them, and never use one for decoration.",
        "section": "colors"
      },
      {
        "name": "The Light Sheet Rule",
        "body": "The post sheet and everything drawn on it (selection handles, empty-state buttons, the empty-state icon disc) stay light in both themes, using literal light values rather than theme variables.",
        "section": "colors"
      },
      {
        "name": "The Heading Face Rule",
        "body": "h1 to h3 are always Poppins; UI text is always Inter. Uppercase belongs to the start h1 alone.",
        "section": "typography"
      },
      {
        "name": "The Readout Rule",
        "body": "Any number the user reads as a measurement (px, ratio, %, hex, version) is Geist Mono with tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Float-Only Rule",
        "body": "Only floating objects cast shadows. Docked chrome (rail, panel, header) is separated by hairlines or the gradient.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the brand gradient to the header and the start hero band.",
      "Do use purple for the active tool, the primary action and text layers; turquoise for canvas selection and focus; yellow for crop only.",
      "Do keep the white Export pill as the one filled control on the gradient.",
      "Do give every new tool icon a 24px grid, 1.75 stroke and exactly one \"duo\" shape.",
      "Do keep the post sheet and its overlays light in both themes.",
      "Do define every chrome colour as a CSS variable in both `:root` and `.dark`, so a theme switch is one repaint with transitions paused for a frame.",
      "Do set measurements, ratios, hex and zoom in Geist Mono with tabular figures."
    ],
    "donts": [
      "Don't add crop marks, registration targets, CMYK strips or proof-slug labels; that world is retired.",
      "Don't put shadows on docked chrome (rail, panel, header).",
      "Don't use turquoise for primary actions or purple for selection rings.",
      "Don't hard-code chrome colours outside the post sheet; theme variables only.",
      "Don't uppercase headings other than the start h1.",
      "Don't put small uppercase kicker labels above headings."
    ]
  }
}
